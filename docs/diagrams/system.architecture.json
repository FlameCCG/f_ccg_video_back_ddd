  "cards": [
    {
      "dot": "cyan",
      "title": "先分清：文件、稿件、状态",
      "items": [
        "源文件在 MinIO / 本地；稿件、分P和源资源在 MySQL。",
        "公开状态不等于转码完成；上传箭头在总览中省略。"
      ]
    },
    {
      "dot": "amber",
      "title": "再分清：提交与异步成功",
      "items": [
        "MySQL 提交后异步投 Kafka；响应不等待投递，当前无 Outbox。",
        "成功或永久错误入 DLQ 后标记位点；重投核验对象与检查点。"
      ]
    },
    {
      "dot": "emerald",
      "title": "最后分清：查询与运行边界",
      "items": [
        "River 派生关键词索引；向量另行维护，应用查询 ES。",
        "HTTP、River、转码、Cron 同进程；跨存储没有统一事务。"
      ]
    }
